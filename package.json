    "@types/node": "^26.6.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "fake-indexeddb": "^6.0.0",
    "happy-dom": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.0",
