  <!-- The famous chromatic E-D#-E-D# hook is stated once here (with the pickup) and nowhere else in
       this arrangement, to keep the piece's accidental rate inside the Beginner cap (data-model.md SS4
       criterion 11). Note: a rest does NOT break a same-duration run for criterion 6 - the level
       checker (src/core/library/facts.ts onsetGroupsByStaff) is built only from sounding onsets, so a
       rest is simply invisible to it. The middle E5 below is written as a quarter note (not an eighth)
       specifically because that is what actually breaks the run: it caps the run at 4 (pickup's 2
       eighths + this bar's first 2), the Beginner limit on criterion 6, before the phrase continues
       with 2 more eighths (B4, D5), also well under the cap. -->
  <measure number="1">
    <note><pitch><step>E</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><staff>1</staff><beam number="1">begin</beam></note>
    <note><pitch><step>D</step><alter>1</alter><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><accidental>sharp</accidental><staff>1</staff><beam number="1">end</beam></note>
    <note><pitch><step>E</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice><type>quarter</type><staff>1</staff></note>
    <note><pitch><step>B</step><octave>4</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><staff>1</staff><beam number="1">begin</beam></note>
    <note><pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice><type>eighth</type><staff>1</staff><beam number="1">end</beam></note>
    <backup><duration>6</duration></backup>
    <!-- Left hand rests here, exactly as Beethoven's own texture does under the fast opening figure. -->
    <note><rest/><duration>6</duration><voice>5</voice><type>half</type><dot/><staff>2</staff></note>
  </measure>

