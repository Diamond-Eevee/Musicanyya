      <note><pitch><step>C</step><octave>4</octave></pitch><duration>/</duration><voice>1</voice></note>
      <note><pitch><step>D</step><octave>4</octave></pitch><duration></duration><voice>1</voice></note>
      <note><pitch><step>E</step><octave>4</octave></pitch><duration>-2</duration><voice>1</voice></note>
