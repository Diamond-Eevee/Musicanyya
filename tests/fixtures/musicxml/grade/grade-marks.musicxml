  <!-- Feature 009 (Play grade marks). One grand staff in G major (one sharp), 4/4, quarter = 100, five measures:
       1  a repeated measure (forward repeat here, backward repeat at its end, so it is played twice) with a
          three-note chord (B4 D5 G5) in the right hand and G3 in the left;
       2  a tie across the barline: the D5 half note is tied to the D5 that opens measure 3;
       3  a grace note (F#4, slashed) before the G4 half note;
       4  an 8va passage (G6 A6 B6 D7 sound, printed an octave lower under the 8va line), the line stopped at the
          end of the measure;
       5  a whole-measure rest in the right hand over two left-hand half notes.
       It is used to test which noteheads a Grade marks and where a wrong or an extra key is drawn. -->
  <part id="P1">
    <measure number="1">
      <attributes>
        <divisions>1</divisions>
        <key><fifths>1</fifths></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <staves>2</staves>
        <clef number="1"><sign>G</sign><line>2</line></clef>
        <clef number="2"><sign>F</sign><line>4</line></clef>
      </attributes>
      <direction><direction-type><metronome><beat-unit>quarter</beat-unit><per-minute>100</per-minute></metronome></direction-type><sound tempo="100"/></direction>
